{
  "appName": "College Feedback Analysis",
  "version": "1.0.0",
  "description": "Student Feedback & Sentiment Analysis Intelligence System",
  "auth": {
    "providers": ["email", "google"],
    "requireVerification": false,
    "allowRegistration": true
  },
  "entities": {
    "Feedback": {
      "path": "entities/Feedback.jsonc",
      "access": {
        "read": ["student", "faculty", "admin", "anonymous"],
        "create": ["student", "faculty", "admin", "anonymous"],
        "update": ["admin"],
        "delete": ["admin"]
      }
    },
    "User": {
      "path": "entities/User.jsonc",
      "access": {
        "read": ["admin", "faculty"],
        "create": ["admin", "anonymous"],
        "update": ["admin", "self"],
        "delete": ["admin"]
      }
    }
  }
}
